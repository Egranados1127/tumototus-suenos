# ══════════════════════════════════════════════════════════════
# TuMotoTus Sueños — Variables de Entorno
# COPIA ESTE ARCHIVO A .env Y COMPLETA LOS VALORES REALES
# NUNCA subas .env al repositorio
# ══════════════════════════════════════════════════════════════

# ─── APLICACIÓN ───────────────────────────────────────────────
NODE_ENV=development
PORT_API=3001
PORT_WEB=3000

# ─── BASE DE DATOS ─────────────────────────────────────────────
POSTGRES_USER=tumoto
POSTGRES_PASSWORD=CAMBIAR_EN_PRODUCCION
POSTGRES_DB=tumototus

# URL principal de la app (schema plataforma + flota)
DATABASE_URL=postgresql://tumoto:CAMBIAR_EN_PRODUCCION@localhost:5432/tumototus

# URL con schema específico para finanzas
DATABASE_URL_FINANZAS=postgresql://tumoto:CAMBIAR_EN_PRODUCCION@localhost:5432/tumototus?schema=finanzas

# ─── AUTH / JWT ────────────────────────────────────────────────
# Mínimo 32 caracteres aleatorios — genera con: openssl rand -base64 32
JWT_SECRETO=CAMBIAR_POR_STRING_ALEATORIO_DE_32_CHARS_MINIMO
JWT_EXPIRACION=8h

# ─── REDIS ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIAR_EN_PRODUCCION

# ─── MINIO (Object Storage) ────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=tumoto_admin
MINIO_ROOT_PASSWORD=CAMBIAR_EN_PRODUCCION
MINIO_BUCKET_DOCUMENTOS=documentos-flota
MINIO_BUCKET_FOTOS=fotos-vehiculos

# ─── FRONTEND ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=CAMBIAR_POR_STRING_ALEATORIO_DE_32_CHARS_MINIMO
NEXTAUTH_URL=http://localhost:3000

# ─── WHATSAPP BUSINESS API (Fase 2) ────────────────────────────
# Obtener en: https://developers.facebook.com
WHATSAPP_TOKEN=PENDIENTE_FASE_2
WHATSAPP_PHONE_ID=PENDIENTE_FASE_2
WHATSAPP_VERIFY_TOKEN=PENDIENTE_FASE_2

# ─── WOMPI / PAGOS (Fase 2) ────────────────────────────────────
# Obtener en: https://wompi.com
WOMPI_PUBLIC_KEY=PENDIENTE_FASE_2
WOMPI_PRIVATE_KEY=PENDIENTE_FASE_2
WOMPI_EVENTS_SECRET=PENDIENTE_FASE_2
